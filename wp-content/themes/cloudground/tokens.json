{
    "$comment": "The one source of the palette and the type. Vite writes it as CSS custom properties (assets/src/css/tokens.generated.css), the plugin writes it into Elementor's Kit, and inc/tokens.php gives it to every plugin that sends email. Change it here, nowhere else. Palette from the approved design (design/reference/home.dc.html); faint, faintOnDark and warmText are the design's faint grey and orange moved just enough to pass WCAG AA at 11px, where the originals measure 4.47:1, 3.79:1 and 2.87:1.",
    "colors": {
        "ground": { "value": "#F2F1EC", "label": "Paper" },
        "groundAlt": { "value": "#E9E7E0", "label": "Paper 2" },
        "surface": { "value": "#FFFFFF", "label": "Surface" },
        "text": { "value": "#0F0F12", "label": "Ink" },
        "soft": { "value": "#3B3B42", "label": "Body text" },
        "meta": { "value": "#55555D", "label": "Muted" },
        "faint": { "value": "#65656D", "label": "Faint" },
        "rule": { "value": "#D6D4CC", "label": "Line" },
        "accent": { "value": "#2F5BFF", "label": "Blue" },
        "accentText": { "value": "#FFFFFF", "label": "Text on blue" },
        "warm": { "value": "#E0612B", "label": "Orange" },
        "warmText": { "value": "#A8411A", "label": "Orange, small text on paper" },
        "dark": { "value": "#0F0F12", "label": "Dark surface" },
        "onDark": { "value": "#F2F1EC", "label": "Text on dark" },
        "onDarkSoft": { "value": "#B7B6AE", "label": "Muted on dark" },
        "faintOnDark": { "value": "#85858D", "label": "Faint on dark" },
        "darkRule": { "value": "#2A2A30", "label": "Line on dark" },
        "darkGhost": { "value": "#1E1E24", "label": "Wordmark on dark" },
        "accentOnDark": { "value": "#7C9BFF", "label": "Blue on dark" },
        "warmOnDark": { "value": "#FF8A55", "label": "Orange on dark" },
        "alert": { "value": "#B3261E", "label": "Alert" }
    },
    "fonts": {
        "heading": { "family": "Archivo", "stack": "Archivo, system-ui, sans-serif", "weight": "560", "label": "Display" },
        "body": { "family": "Archivo", "stack": "Archivo, system-ui, sans-serif", "weight": "400", "label": "Body" },
        "serif": { "family": "Instrument Serif", "stack": "'Instrument Serif', Georgia, serif", "weight": "400", "label": "Accent (italic)" },
        "mono": { "family": "Geist Mono", "stack": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace", "weight": "500", "label": "HUD labels" }
    },
    "radius": "0px",
    "kit": {
        "colors": { "primary": "text", "secondary": "ground", "text": "soft", "accent": "accent" },
        "typography": { "primary": "heading", "secondary": "mono", "text": "body", "accent": "serif" }
    },
    "email": {
        "background": "ground",
        "surface": "surface",
        "text": "text",
        "muted": "meta",
        "accent": "accent",
        "accent_text": "accentText",
        "link": "accent",
        "border": "rule",
        "font_body": "body",
        "font_heading": "heading"
    }
}
